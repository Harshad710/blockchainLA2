# Environment
PORT=3000
NODE_ENV=development

# x402 Payment Configuration
PAYMENTS_ENABLED=false
X402_NETWORK=eip155:84532
X402_PAY_TO=0xREPLACE_WITH_BASE_SEPOLIA_RECEIVING_ADDRESS
X402_PROFILE_PRICE=0.001
X402_BATCH_PRICE=0.005
X402_FACILITATOR_URL=https://x402.org/facilitator

# Buyer Configuration (for buyer/ scripts)
BUYER_PRIVATE_KEY=
API_BASE_URL=http://localhost:3000

# Demo Buyer Bridge (server-side only, for dashboard demo)
ENABLE_DEMO_BUYER=false

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
